# ==============================================================================
# SANAL ÇADIR (sanalcadir.com) İNDİRİM & STOK TAKİP BOTU - AYAR ŞABLONU
# Kullanım: Bu dosyayı ".env" adıyla kopyalayın ve kendi bilgilerinizle doldurun.
# ==============================================================================

# --- 1. TELEGRAM BOT AYARLARI ---
# @BotFather üzerinden aldığınız bot token'ı:
TELEGRAM_BOT_TOKEN=1234567890:AAH_ornek_token_buraya_gelecek
# Bildirimlerin gideceği Chat ID (Kişisel ID veya Grup/Kanal ID):
TELEGRAM_CHAT_ID=123456789

# --- 2. HEDEF KATEGORİ VE NUMARA URL'LERİ (Akinon Filtreli URL'ler) ---
# Erkek Ayakkabı: 45 ve 45.5 (Akinon'da buçuklu bedenler 45,5 olarak filtrelenir)
ERKEK_CATEGORY_URL=https://www.sanalcadir.com/erkek-ayakkabi/?attributes_filterable_size=45&attributes_filterable_size=45,5

# Kadın Ayakkabı: 39 ve 40
KADIN_CATEGORY_URL=https://www.sanalcadir.com/kadin-ayakkabi/?attributes_filterable_size=39&attributes_filterable_size=40

# Takip edilecek hedef numaralar (virgülle ayrılmış)
ERKEK_TARGET_SIZES=45,45.5
KADIN_TARGET_SIZES=39,40

# --- 3. FİLTRELEME VE KALİTE AYARLARI ---
# Hariç tutulacak kelimeler (virgülle ayrılmış - ürün adında geçerse elenir)
EXCLUDE_KEYWORDS=terlik,sandalet,panduf,deniz,çorap,bakım,bağcık,çocuk,bebek

# Marka Filtresi:
# Boş bırakılırsa (ALLOWED_BRANDS=) tüm markalar kabul edilir.
# Sadece belirli markaları takip etmek için virgülle ayırarak yazabilirsiniz:
# Örn: ALLOWED_BRANDS=Nike,Adidas,New Balance,Puma,Lacoste,Skechers,Vans,Timberland,Converse
ALLOWED_BRANDS=

# Maksimum Fiyat Sınırı (TL) - Net (indirimli/sepet) fiyatı bu sınırı aşan ürünler bildirilmez
MAX_PRICE_LIMIT=10000
ERKEK_MAX_PRICE_LIMIT=10000
KADIN_MAX_PRICE_LIMIT=10000

# İlk kez stoğa giren ürünlerde aranacak minimum indirim yüzdesi (%)
MIN_DISCOUNT_RATE=20

# Mevcut kayıtlı bir üründe bildirim atılması için gereken minimum ekstra fiyat düşüş oranı (%)
PRICE_DROP_THRESHOLD=5

# --- 4. ÇALIŞMA VE DURUM AYARLARI ---
# İlk çalıştırmada (products_state.json boşken) mevcut tüm ürünler için bildirim gönderilsin mi?
# Spam önlemek için False tutulması şiddetle önerilir.
NOTIFY_ON_FIRST_RUN=False

# Döngü modunda (--loop) taramalar arası bekleme süresi (dakika)
CHECK_INTERVAL_MINUTES=20

# Kritik stok uyarı eşiği (Stok bu sayı ve altındaysa "Son X Adet!" uyarısı gösterilir)
CRITICAL_STOCK_LIMIT=3

# Telegram mesajları arası bekleme süresi (saniye - flood/rate-limit koruması)
TELEGRAM_RATE_LIMIT_DELAY=1.5

# Tek bir kategoride taranacak maksimum sayfa sayısı (0 = tüm sayfalar)
MAX_PAGES_PER_CATEGORY=0
